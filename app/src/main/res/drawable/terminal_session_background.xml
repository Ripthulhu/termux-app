<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true"><shape><solid android:color="@color/terminal_surface_active" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/terminal_surface_raised" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/terminal_surface_raised" /><stroke android:width="1dp" android:color="@color/terminal_accent" /><corners android:radius="12dp" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>
