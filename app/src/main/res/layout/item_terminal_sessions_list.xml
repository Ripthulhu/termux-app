<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="68dp" android:padding="12dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:background="@drawable/terminal_session_background">
    <TextView android:id="@+id/session_number" android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:fontFamily="monospace" android:textSize="12sp"
        android:textColor="@color/terminal_accent" android:background="@drawable/terminal_session_badge" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/session_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textColor="@color/terminal_text" android:textSize="15sp"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/session_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/terminal_text_secondary" android:textSize="12sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
