      "html": "<button class=\"ds-extra-key-active\" aria-pressed=\"true\">CTRL</button>",
      "css": ".ds-extra-key-active { box-sizing:border-box;min-width:48px;min-height:48px;margin:0 4px;padding:0 4px;border:0;border-top:3px solid transparent;border-bottom:3px solid transparent;border-radius:6px;background:#D0E8D6;background-clip:padding-box;color:#0A1F13;font:500 12px/16px sans-serif;letter-spacing:0;white-space:nowrap;cursor:pointer; } .ds-extra-key-active:hover { filter:brightness(.97); } .ds-extra-key-active:focus-visible { outline:2px solid #006D43;outline-offset:1px; } .ds-extra-key-active:active { background-color:#D0E8D6;color:#0A1F13; }"
    },
    {
      "name": "Terminal visibility toggle",
      "kind": "button",
      "refersTo": "visibility-toggle",
      "description": "Static idle light-fallback preview; native checked state uses the secondary container pair.",
      "html": "<button class=\"ds-visibility\" aria-label=\"Keep terminal visible\" aria-pressed=\"false\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M19 7h-8v6h8V7zm2-4H3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 16H3V5h18v14z\"/></svg></button>",
      "css": ".ds-visibility { display:grid;place-items:center;width:48px;height:48px;padding:0;border:0;border-radius:24px;background:transparent;color:#414941;cursor:pointer; } .ds-visibility:hover { background:#E4EAE2; } .ds-visibility:focus-visible { outline:2px solid #006D43;outline-offset:1px; } .ds-visibility:active,.ds-visibility[aria-pressed=\"true\"] { background:#D0E8D6;color:#0A1F13; }"
    },
    {
      "name": "Terminal text input",
      "kind": "input",
      "refersTo": "terminal-text-input",
      "description": "Static approximation of the native single-line EditText; the underline/focus preview is illustrative inherited platform treatment.",
      "html": "<input class=\"ds-terminal-input\" type=\"text\" aria-label=\"Terminal text input\" placeholder=\"Terminal input\"/>",
      "css": ".ds-terminal-input { width:100%;min-height:48px;padding:0;border:0;border-bottom:1px solid #717970;border-radius:0;background:#F6FBF4;color:#181D18;font:400 16px/24px sans-serif;letter-spacing:.5px; } .ds-terminal-input::placeholder { color:#414941; } .ds-terminal-input:hover { border-bottom-color:#181D18; } .ds-terminal-input:focus-visible { outline:0;border-bottom:2px solid #006D43; }"
    },
    {
      "name": "Sessions panel",
      "kind": "nav",
      "refersTo": "session-panel",
      "description": "Static compact light-fallback preview: width is min(320dp, usable root width minus 16dp), recomputed on each native compact resize. Expanded mode stays 320dp at 840dp and above. The header stacks according to measured title and action width.",
      "html": "<nav class=\"ds-session-panel\" aria-label=\"Sessions\"><div class=\"ds-panel-heading\"><span class=\"ds-panel-title\">Sessions</span><div class=\"ds-panel-actions\"><button class=\"ds-panel-icon\" aria-label=\"Toggle keyboard\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M20,5H4c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2V7c0,-1.1 -0.9,-2 -2,-2zM20,17H4V7h16v10zM6,8h2v2H6zM9,8h2v2H9zM12,8h2v2h-2zM15,8h3v2h-3zM6,11h2v2H6zM9,11h2v2H9zM12,11h2v2h-2zM15,11h3v2h-3zM8,14h8v2H8z\"/></svg></button><button class=\"ds-panel-icon\" aria-label=\"Settings\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z\"/></svg></button><button class=\"ds-panel-icon\" aria-label=\"Close sessions\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z\"/></svg></button></div></div><div class=\"ds-panel-content\">Session list and actions</div></nav>",
      "css": ".ds-session-panel { width:min(320px, max(0px, calc(100% - 16px)));max-width:100%;border-radius:16px;background:#F0F5EE;color:#181D18; } .ds-panel-heading { display:flex;flex-wrap:wrap;align-items:center;min-height:64px;font:500 16px/24px sans-serif; } .ds-panel-title { flex:1 0 auto;min-width:max-content;padding-inline-start:20px; } .ds-panel-actions { display:flex;margin-inline-start:auto; } .ds-panel-icon { display:grid;place-items:center;flex:0 0 48px;width:48px;height:48px;padding:0;border:0;border-radius:24px;background:transparent;color:#414941;cursor:pointer; } .ds-panel-content { padding:12px;font:400 12px/16px sans-serif;color:#414941; } .ds-session-panel:hover { background:#F0F5EE; } .ds-session-panel:focus-visible { outline:2px solid #006D43;outline-offset:2px; } .ds-panel-icon:hover { background:#E4EAE2; } .ds-panel-icon:focus-visible { outline:2px solid #006D43;outline-offset:-2px; } .ds-panel-icon:active { background:#D0E8D6; }"
    }
