  "narrative": {
    "northStar": "Polished native Android utility",
    "overview": "The interface uses Material Design 3 on the existing Java/Android Views stack. Native controls provide familiar navigation, tonal surfaces and readable labels around the custom terminal renderer. This records core Material 3 implementation, not a Compose conversion or a complete Material 3 Expressive migration.\n\nThe terminal remains the main content. Controls have deliberate touch areas, sessions remain reachable through an explicit control, and the same session panel adapts to the available window. Dynamic color personalizes the Android chrome; a green light/dark palette supplies the static fallback. Terminal colors and fonts remain user controlled.",
    "keyCharacteristics": [
      "Native Material 3 Views controls and semantic color roles.",
      "Readable terminal content with separate Android interface typography.",
      "Explicit session access that preserves Android edge Back gestures.",
      "A modal panel in compact windows and a persistent panel in expanded windows.",
      "Single-line extra keys that scroll horizontally rather than wrap."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule.",
        "body": "Resolve interface colors through Material attributes and pair each container with its matching on-color; hard-coded fallback colors belong in resources, not individual controls.",
        "section": "colors"
      },
      {
        "name": "The Terminal Boundary Rule.",
        "body": "Keep ANSI colors, terminal background and terminal font preferences independent of the Android Material palette.",
        "section": "colors"
      },
      {
        "name": "The Two Type Systems Rule.",
        "body": "Use scalable Material text appearances for Android controls and preserve the terminal renderer's configurable monospace typography.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use Material semantic color pairs for Android controls and retain dynamic-color support.",
      "**Do** keep the terminal's saved font, colors and custom key layout independent of the interface theme.",
      "**Do** use explicit Sessions access and preserve Android's edge Back gesture.",
      "**Do** adapt the same session panel to current window width, including resize back to compact mode.",
      "**Do** retain scalable interface text, minimum 48dp key targets and horizontal key scrolling in narrow windows.",
      "**Do** use content descriptions and explicit status text alongside icons and color."
    ],
    "donts": [
      "**Don't** wrap the extra-key toolbar into oversized controls or replace the user's key layout.",
      "**Don't** introduce a Compose dependency or describe the existing Views implementation as a complete Expressive migration.",
      "**Don't** make a terminal color scheme follow the Android wallpaper palette automatically.",
      "**Don't** treat legacy shared Material Components themes or inherited native input styling as newly standardized Material 3 patterns."
    ]
  }
}
