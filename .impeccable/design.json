  "components": [
    {
      "name": "New session action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Static light-fallback TerminalAction with 16dp start/end padding and up to two label lines; native ripple and text scaling remain library behavior.",
      "html": "<button class=\"ds-action-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z\"/></svg><span>New session</span></button>",
      "css": ".ds-action-primary { box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:56px;padding:6px 16px;border:0;border-radius:999px;background:#006D43;color:#FFFFFF;font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer; } .ds-action-primary:hover { filter:brightness(.97); } .ds-action-primary:focus-visible { outline:2px solid #006D43;outline-offset:2px; } .ds-action-primary:active { filter:brightness(.92); } .ds-action-primary svg { flex-shrink:0; } .ds-action-primary span { min-width:0;max-height:40px;overflow:hidden;white-space:normal; }"
    },
    {
      "name": "Resume Codex action",
      "kind": "button",
      "refersTo": "button-tonal",
      "description": "Static light-fallback TerminalAction with 16dp start/end padding and up to two label lines; native ripple and text scaling remain library behavior.",
      "html": "<button class=\"ds-action-tonal\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M13 3a9 9 0 0 0-8.7 7H1l4 4 4-4H6.4A7 7 0 1 1 8 18l-1.4 1.4A9 9 0 1 0 13 3zm-1 4v6l5 3 1-1.7-4-2.3V7z\"/></svg><span>Resume Codex</span></button>",
      "css": ".ds-action-tonal { box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:56px;padding:6px 16px;border:0;border-radius:999px;background:#D0E8D6;color:#0A1F13;font:500 14px/20px sans-serif;letter-spacing:.1px;cursor:pointer; } .ds-action-tonal:hover { filter:brightness(.97); } .ds-action-tonal:focus-visible { outline:2px solid #006D43;outline-offset:2px; } .ds-action-tonal:active { filter:brightness(.92); } .ds-action-tonal svg { flex-shrink:0; } .ds-action-tonal span { min-width:0;max-height:40px;overflow:hidden;white-space:normal; }"
    },
    {
      "name": "Session row",
      "kind": "nav",
      "refersTo": "session-row",
      "description": "Static light-fallback session row; unselected focus uses a higher tonal surface and a 2dp primary outline.",
      "html": "<button class=\"ds-session\"><span class=\"ds-session-badge\">1</span><span class=\"ds-session-copy\"><span class=\"ds-session-title\">Session 1</span><span class=\"ds-session-status\">Running</span></span></button>",
      "css": ".ds-session { box-sizing:border-box;display:flex;align-items:center;gap:12px;width:100%;min-height:68px;padding:12px;border:0;border-radius:28px;text-align:start;background:transparent;color:#181D18;cursor:pointer; } .ds-session .ds-session-badge { display:grid;place-items:center;flex:0 0 32px;height:32px;border-radius:16px;background:#D0E8D6;color:#0A1F13;font:500 14px/20px sans-serif; } .ds-session .ds-session-copy { display:flex;flex-direction:column;gap:4px;min-width:0; } .ds-session .ds-session-title { font:500 14px/20px sans-serif; } .ds-session .ds-session-status { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#414941;font:400 12px/16px sans-serif; } .ds-session:hover { background:#DCE5DA; } .ds-session:focus-visible { background:#E4EAE2;outline:2px solid #006D43;outline-offset:-2px; } .ds-session:active { background:#D0E8D6; }"
    },
    {
      "name": "Selected session",
      "kind": "nav",
      "refersTo": "session-row-selected",
      "description": "Static light-fallback selected session; focus keeps the secondary-container fill and adds a 2dp primary outline.",
      "html": "<button class=\"ds-session-selected\" aria-current=\"true\"><span class=\"ds-session-badge\">1</span><span class=\"ds-session-copy\"><span class=\"ds-session-title\">Session 1</span><span class=\"ds-session-status\">Running</span></span></button>",
      "css": ".ds-session-selected { box-sizing:border-box;display:flex;align-items:center;gap:12px;width:100%;min-height:68px;padding:12px;border:0;border-radius:28px;text-align:start;background:#D0E8D6;color:#0A1F13;cursor:pointer; } .ds-session-selected .ds-session-badge { display:grid;place-items:center;flex:0 0 32px;height:32px;border-radius:16px;background:#D0E8D6;color:#0A1F13;font:500 14px/20px sans-serif; } .ds-session-selected .ds-session-copy { display:flex;flex-direction:column;gap:4px;min-width:0; } .ds-session-selected .ds-session-title { font:500 14px/20px sans-serif; } .ds-session-selected .ds-session-status { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#0A1F13;font:400 12px/16px sans-serif; } .ds-session-selected:hover { background:#DCE5DA; } .ds-session-selected:focus-visible { background:#D0E8D6;outline:2px solid #006D43;outline-offset:-2px; } .ds-session-selected:active { background:#D0E8D6; }"
    },
    {
      "name": "Extra key",
      "kind": "button",
      "refersTo": "extra-key",
      "description": "Static solid idle key at the 48dp minimum target; native Material background tint preserves pressed ripple, repeats and popups.",
      "html": "<button class=\"ds-extra-key\">Tab</button>",
      "css": ".ds-extra-key { box-sizing:border-box;min-width:48px;min-height:48px;margin:0 4px;padding:0 4px;border:0;border-top:3px solid transparent;border-bottom:3px solid transparent;border-radius:6px;background:#E4EAE2;background-clip:padding-box;color:#181D18;font:500 12px/16px sans-serif;letter-spacing:0;white-space:nowrap;cursor:pointer; } .ds-extra-key:hover { filter:brightness(.97); } .ds-extra-key:focus-visible { outline:2px solid #006D43;outline-offset:1px; } .ds-extra-key:active { background-color:#D0E8D6;color:#181D18; }"
    },
    {
      "name": "Pressed active modifier",
